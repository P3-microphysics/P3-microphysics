#!/bin/bash
# run_full_tests — compile and run all 4 kin1d configurations for P3.
#
# Usage:
#   ./run_full_tests              # run tests, save to kin1d_tests/results-last_commit/
#   ./run_full_tests --compare    # run tests, then compare to reference (exact mode)
#   ./run_full_tests --compare-tol  # run tests, then compare with tolerance (rtol=0.01)
#
# After running, compare manually with:
#   python compare_runs.py                    # exact mode
#   python compare_runs.py --mode tol         # tolerance mode

set -e

COMPARE_MODE=""
for arg in "$@"; do
    case $arg in
        --compare)     COMPARE_MODE="exact" ;;
        --compare-tol) COMPARE_MODE="tol"   ;;
    esac
done

# Root directory for output (run from kin1d/src/)
rootdir="."

# Git hash for plot titles
p3_version=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

# ── Compile ──────────────────────────────────────────────────────────────────
make clean
make execld

# ── Rotate results directories ────────────────────────────────────────────────
rm -rf ${rootdir}/kin1d_tests/results-previous_commit
if [ -d "${rootdir}/kin1d_tests/results-last_commit" ]; then
    mv ${rootdir}/kin1d_tests/results-last_commit \
       ${rootdir}/kin1d_tests/results-previous_commit
fi
mkdir -p ${rootdir}/kin1d_tests/results-last_commit

# ── Run all configs ───────────────────────────────────────────────────────────
for config in p3_config-*.txt; do
    id=$(echo $config | sed 's/p3_config-\(.*\)\.txt/\1/')
    ncat="${id:0:1}"

    echo "Running configuration $id..."
    cp "$config" p3_config.txt
    ./execld
    python3 plot_kin1d.py -i out_p3.dat -t "${p3_version}, config: ${id}" -n ${ncat}

    mv out_p3.dat "${rootdir}/kin1d_tests/results-last_commit/out_p3_${id}.dat"
    mv timing.txt "${rootdir}/kin1d_tests/results-last_commit/timing_${id}.txt"
    mv fig.png    "${rootdir}/kin1d_tests/results-last_commit/fig_${id}.png"

    echo "Completed configuration $id"
    echo "----------------------------------------"
done

cp microphy_p3.f90 cld1d.f90 plot_kin1d.py \
   ${rootdir}/kin1d_tests/results-last_commit

echo "All configurations completed!"

# ── Optional comparison ───────────────────────────────────────────────────────
if [ -n "$COMPARE_MODE" ]; then
    echo
    if [ ! -d "${rootdir}/kin1d_tests/results-reference" ]; then
        echo "WARNING: no reference directory found; skipping comparison."
        echo "  Run save_reference.sh before making code changes to establish a baseline."
    else
        SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
        if [ "$COMPARE_MODE" = "tol" ]; then
            python3 "${SCRIPT_DIR}/compare_runs.py" --mode tol --rtol 0.01 --atol 1e-7
        else
            python3 "${SCRIPT_DIR}/compare_runs.py" --mode exact
        fi
    fi
fi
